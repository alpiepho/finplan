Output docs/screenshots/raw/example-04-results-single-run.png

Set Shell "bash"
Set Width 1600
Set Height 900
Set FontSize 13
Set Theme "Dracula"

Type "./target/debug/finplan --quiet -s examples/example.yaml"
Enter
Sleep 5s

Type "4"
Sleep 3s

# Run a single deterministic simulation (r)
Type "r"
Sleep 15s

Screenshot docs/screenshots/raw/example-04-results-single-run.png

Sleep 2s
Type "q"
Sleep 500ms
